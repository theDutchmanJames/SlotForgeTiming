# Line endings: the app's own text files are LF on every OS; Windows batch files are CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Byte-exact data keeps its recorded bytes: bundled vendor files have verified hashes,
# and fixtures and hardware logs are recordings that tests compare exactly.
vendor/** -text
tests/fixtures/** -text
tools/fixtures/** -text
tools/qa/fixtures/** -text
docs/trackmate-logs/** -text

# Tooling and tests remain in source; local review material does not.
/docs/ui-reference export-ignore
