{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private merge contribution projection v1",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "token": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "epoch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "required": [
            "id",
            "revision",
            "epoch"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sourceId",
        "sessionId"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "databaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "recoveryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "mergeRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "token": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "epoch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "required": [
            "id",
            "revision",
            "epoch"
          ],
          "additionalProperties": false
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "format": {
          "enum": [
            "timing-v1",
            "history-v1",
            "raw-only"
          ]
        },
        "state": {
          "enum": [
            "active",
            "withdrawn"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "participantId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "originalCarId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "canonicalCarId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "status": {
                "enum": [
                  "included",
                  "excluded",
                  "pending",
                  "conflict"
                ]
              },
              "mergeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[a-zA-Z0-9_-]+$"
                }
              }
            },
            "required": [
              "participantId",
              "originalCarId",
              "canonicalCarId",
              "status",
              "mergeIds"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "databaseId",
        "recoveryId",
        "mergeRevision",
        "token",
        "sourceId",
        "sessionId",
        "format",
        "state",
        "rows",
        "total",
        "offset",
        "nextOffset"
      ],
      "additionalProperties": false
    }
  }
}
