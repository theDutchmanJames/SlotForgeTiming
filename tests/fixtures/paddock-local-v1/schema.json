{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SlotForge local library v1",
  "description": "Use the named $defs entry for each message. Semantic identity, uniqueness, image and byte-size rules also apply; see README.",
  "$defs": {
    "descriptor": {
      "type": "object",
      "properties": {
        "format": {
          "const": "slotforge-local-library"
        },
        "version": {
          "const": 1
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "address": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}$"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "databaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "format",
        "version",
        "instanceId",
        "pid",
        "address",
        "token",
        "databaseId",
        "name"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "databaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "transferId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "export": {
          "type": "object",
          "properties": {
            "format": {
              "const": "slotforge-timing-export"
            },
            "fileVersion": {
              "const": 1
            },
            "exported": {
              "type": "string",
              "maxLength": 100
            },
            "items": {
              "type": "object",
              "properties": {
                "slotcars": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "name": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20000
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "brand": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20000
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "manufacturer": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20000
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "model": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20000
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "scale": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20000
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "reference": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20000
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "motor": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20000
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "gearing": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20000
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "weight": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20000
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "raceClass": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20000
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "tyres": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20000
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "picture": {
                        "type": "string",
                        "maxLength": 8388608
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 25,
                  "minItems": 1
                },
                "raceclasses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "name": {
                        "type": "string",
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "id",
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 10000,
                  "minItems": 0
                }
              },
              "required": [
                "slotcars"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "format",
            "fileVersion",
            "items"
          ],
          "additionalProperties": false
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timingCarId": {
                "type": "string",
                "maxLength": 200
              },
              "paddockCarId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "expectedRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "timingCarId",
              "paddockCarId",
              "expectedRevision"
            ],
            "additionalProperties": false
          },
          "maxItems": 25,
          "minItems": 0
        }
      },
      "required": [
        "version",
        "databaseId",
        "sourceId",
        "transferId",
        "export"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "databaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "submissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "transferId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "pending",
            "reviewed"
          ]
        },
        "duplicate": {
          "type": "boolean"
        },
        "cars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "itemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "timingCarId": {
                "type": "string",
                "maxLength": 200
              },
              "action": {
                "enum": [
                  "create",
                  "link"
                ]
              },
              "paddockCarId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "decision": {
                "enum": [
                  "pending",
                  "accept",
                  "reject"
                ]
              },
              "status": {
                "enum": [
                  "pending",
                  "approved",
                  "rejected",
                  "cancelled"
                ]
              },
              "reviewedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "carRevision": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "present": {
                "type": "boolean"
              },
              "archived": {
                "type": "boolean"
              }
            },
            "required": [
              "index",
              "itemId",
              "timingCarId",
              "action",
              "paddockCarId",
              "decision",
              "status",
              "reviewedAt",
              "carRevision",
              "present",
              "archived"
            ],
            "additionalProperties": false
          },
          "maxItems": 25,
          "minItems": 1
        }
      },
      "required": [
        "version",
        "databaseId",
        "submissionId",
        "sourceId",
        "transferId",
        "hash",
        "status",
        "cars"
      ],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "itemIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "maxItems": 25,
          "minItems": 1
        }
      },
      "required": [
        "version",
        "itemIds"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "maxLength": 20000
        },
        "code": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "error",
        "code"
      ],
      "additionalProperties": false
    }
  }
}
